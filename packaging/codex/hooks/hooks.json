{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/task_harness.py\"",
            "commandWindows": "cmd /d /c py -3 \"%PLUGIN_ROOT%\\hooks\\task_harness.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/task_harness.py\"",
            "commandWindows": "cmd /d /c py -3 \"%PLUGIN_ROOT%\\hooks\\task_harness.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/task_harness.py\"",
            "commandWindows": "cmd /d /c py -3 \"%PLUGIN_ROOT%\\hooks\\task_harness.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
