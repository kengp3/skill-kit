+package com.example.concurrentrequestscope;
+
+import io.micrometer.context.ContextRegistry;
+import io.micrometer.context.ContextSnapshot;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.context.annotation.AnnotationConfigApplicationContext;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.core.env.MapPropertySource;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.web.context.request.RequestAttributesThreadLocalAccessor;
+import org.springframework.web.context.request.RequestContextHolder;
+import org.springframework.web.context.request.ServletRequestAttributes;
+
+import java.util.Map;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.FutureTask;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static com.example.concurrentrequestscope.support.ConcurrentRequestScopeStateAssertions.assertBaseline;
+import static org.junit.jupiter.api.Assertions.*;
+
+class ConcurrentRequestScopeLifecycleTest {
+
+    @AfterEach
+    void resetRequest() {
+        RequestContextHolder.resetRequestAttributes();
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {true, false})
+    void contextCloseReleasesEntriesAndStopsOwnedCleaner(boolean cleanupEnabled) throws Exception {
+        try (var context = context(cleanupEnabled, "1h", "1h")) {
+            ConcurrentRequestScope scope = scope(context);
+            ScheduledExecutorService cleaner = cleaner(scope);
+            var attrs = bindRequest();
+            AtomicInteger destroyed = new AtomicInteger();
+            scope.get("bean", Object::new);
+            scope.registerDestructionCallback("bean", destroyed::incrementAndGet);
+            scope.get("failing", Object::new);
+            scope.registerDestructionCallback("failing", () -> { throw new IllegalStateException("expected"); });
+            var retainedEntry = scope.stateForTesting().getEntry(scope.scopeKeyForTesting(attrs));
+
+            context.close();
+
+            assertEquals(1, destroyed.get());
+            assertEquals(1, scope.stateForTesting().cleanupFailureCount());
+            assertBaseline(scope.stateForTesting());
+            assertTrue(((Map<?, ?>) ReflectionTestUtils.getField(retainedEntry, "slots")).isEmpty());
+            if (cleanupEnabled) {
+                assertTrue(cleaner.isShutdown());
+                assertTrue(cleaner.awaitTermination(2, TimeUnit.SECONDS));
+            } else {
+                assertNull(cleaner);
+            }
+            attrs.requestCompleted();
+            context.close();
+            assertEquals(1, destroyed.get());
+            assertBaseline(scope.stateForTesting());
+            assertThrows(IllegalStateException.class, () -> scope.get("late", Object::new));
+        }
+    }
+
+    @Test
+    void ttlCallbackCanCloseItsOwnContext() throws Exception {
+        var context = context(true, "100ms", "100ms");
+        ConcurrentRequestScope scope = scope(context);
+        CountDownLatch closed = new CountDownLatch(1);
+        bindRequest();
+        scope.get("bean", Object::new);
+        scope.registerDestructionCallback("bean", () -> {
+            context.close();
+            closed.countDown();
+        });
+        RequestContextHolder.resetRequestAttributes();
+
+        assertTrue(closed.await(2, TimeUnit.SECONDS), "callback close must not deadlock or await itself");
+        assertTrue(cleaner(scope).awaitTermination(2, TimeUnit.SECONDS));
+        assertBaseline(scope.stateForTesting());
+    }
+
+    @Test
+    void closeInterruptsAnInFlightTtlCallback() throws Exception {
+        var context = context(true, "100ms", "100ms");
+        ConcurrentRequestScope scope = scope(context);
+        CountDownLatch entered = new CountDownLatch(1);
+        CountDownLatch release = new CountDownLatch(1);
+        CountDownLatch interrupted = new CountDownLatch(1);
+        bindRequest();
+        scope.get("bean", Object::new);
+        scope.registerDestructionCallback("bean", () -> {
+            entered.countDown();
+            try {
+                release.await();
+            } catch (InterruptedException e) {
+                interrupted.countDown();
+                Thread.currentThread().interrupt();
+            }
+        });
+        try {
+            assertTrue(entered.await(2, TimeUnit.SECONDS));
+            FutureTask<Void> closing = new FutureTask<>(() -> { context.close(); return null; });
+            Thread.ofVirtual().start(closing);
+            closing.get(2, TimeUnit.SECONDS);
+            assertEquals(0, interrupted.getCount());
+            assertTrue(cleaner(scope).isTerminated());
+            assertBaseline(scope.stateForTesting());
+        } finally {
+            release.countDown();
+            context.close();
+        }
+    }
+
+    @Test
+    void beanFactoryCanCloseContextAndLateDestructionCallbackStillReleasesBean() {
+        try (var context = context(false, "1h", "1h")) {
+            ConcurrentRequestScope scope = scope(context);
+            bindRequest();
+            AtomicInteger destroyed = new AtomicInteger();
+            assertThrows(IllegalStateException.class, () -> scope.get("bean", () -> {
+                context.close();
+                scope.registerDestructionCallback("bean", destroyed::incrementAndGet);
+                return new Object();
+            }));
+            assertEquals(1, destroyed.get());
+            assertBaseline(scope.stateForTesting());
+        }
+    }
+
+    @Test
+    void entryRetainedAcrossCloseDoesNotLoseLateCallbacksOrBeans() {
+        try (var context = context(false, "1h", "1h")) {
+            ConcurrentRequestScope scope = scope(context);
+            var attrs = bindRequest();
+            scope.get("bean", Object::new);
+            var entry = scope.stateForTesting().getEntry(scope.scopeKeyForTesting(attrs));
+            context.close();
+            AtomicInteger callbacks = new AtomicInteger();
+            entry.registerDestructionCallback("late", callbacks::incrementAndGet);
+            assertEquals(1, callbacks.get());
+            assertEquals(0, entry.runDestructionCallbacks((name, failure) -> fail(failure)));
+            assertEquals(1, callbacks.get());
+            assertThrows(IllegalStateException.class, () -> entry.getOrCreateBean("late", Object::new));
+        }
+    }
+
+    @Test
+    void failedContextStartupAlsoStopsItsCleaner() throws Exception {
+        var context = new AnnotationConfigApplicationContext();
+        AtomicReference<ConcurrentRequestScope> createdScope = new AtomicReference<>();
+        context.register(EnabledConfig.class);
+        context.registerBean("startupFailure", Object.class, () -> {
+            createdScope.set(scope(context));
+            throw new IllegalStateException("expected startup failure");
+        });
+        try {
+            assertThrows(org.springframework.beans.BeansException.class, context::refresh);
+            assertNotNull(createdScope.get());
+            assertTrue(cleaner(createdScope.get()).awaitTermination(2, TimeUnit.SECONDS));
+            assertBaseline(createdScope.get().stateForTesting());
+        } finally {
+            context.close();
+        }
+    }
+
+    @Test
+    void closingOneContextPreservesOtherContextsCleanerAndSharedAccessor() throws Exception {
+        try (var first = context(true, "100ms", "100ms");
+             var second = context(true, "100ms", "100ms")) {
+            ConcurrentRequestScope firstScope = scope(first);
+            ConcurrentRequestScope secondScope = scope(second);
+            var accessor = ContextRegistry.getInstance().getThreadLocalAccessors().stream()
+                    .filter(a -> a instanceof RequestAttributesThreadLocalAccessor).findFirst().orElseThrow();
+            first.close();
+            assertTrue(cleaner(firstScope).awaitTermination(2, TimeUnit.SECONDS));
+            assertFalse(cleaner(secondScope).isShutdown());
+            assertTrue(ContextRegistry.getInstance().getThreadLocalAccessors().contains(accessor));
+
+            var attrs = bindRequest();
+            Object bean = secondScope.get("bean", Object::new);
+            var snapshot = ContextSnapshot.captureAll();
+            RequestContextHolder.resetRequestAttributes();
+            try (var ignored = snapshot.setThreadLocals()) {
+                assertSame(attrs.getRequest(), ((ServletRequestAttributes)
+                        RequestContextHolder.currentRequestAttributes()).getRequest());
+                assertSame(bean, secondScope.get("bean", Object::new));
+            }
+            CountDownLatch expired = new CountDownLatch(1);
+            RequestContextHolder.setRequestAttributes(attrs);
+            secondScope.registerDestructionCallback("bean", expired::countDown);
+            RequestContextHolder.resetRequestAttributes();
+            assertTrue(expired.await(2, TimeUnit.SECONDS), "live context must still run TTL cleanup");
+            second.close();
+            assertBaseline(secondScope.stateForTesting());
+        }
+    }
+
+    private static AnnotationConfigApplicationContext context(boolean enabled, String ttl, String interval) {
+        var context = new AnnotationConfigApplicationContext();
+        context.getEnvironment().getPropertySources().addFirst(new MapPropertySource("test", Map.of(
+                "concurrent-request-scope.stale-entry-cleanup.enabled", enabled,
+                "concurrent-request-scope.stale-entry-cleanup.ttl", ttl,
+                "concurrent-request-scope.stale-entry-cleanup.scan-interval", interval)));
+        context.register(EnabledConfig.class);
+        context.refresh();
+        return context;
+    }
+
+    private static ConcurrentRequestScope scope(AnnotationConfigApplicationContext context) {
+        return (ConcurrentRequestScope) context.getBeanFactory()
+                .getRegisteredScope(ConcurrentRequestScopeNames.CONCURRENT_REQUEST_SCOPE);
+    }
+
+    private static ScheduledExecutorService cleaner(ConcurrentRequestScope scope) {
+        return (ScheduledExecutorService) ReflectionTestUtils.getField(scope, "staleEntryCleanupExecutor");
+    }
+
+    private static ServletRequestAttributes bindRequest() {
+        var attrs = new ServletRequestAttributes(new MockHttpServletRequest());
+        RequestContextHolder.setRequestAttributes(attrs);
+        return attrs;
+    }
+
+    @Configuration(proxyBeanMethods = false)
+    @EnableConcurrentRequestScope
+    static class EnabledConfig {}
+}
