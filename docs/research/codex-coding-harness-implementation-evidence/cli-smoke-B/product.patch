+package com.example.concurrentrequestscope;
+
+import io.micrometer.context.ContextRegistry;
+import io.micrometer.context.ContextSnapshot;
+import io.micrometer.context.ContextSnapshotFactory;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.context.annotation.AnnotationConfigApplicationContext;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.core.env.MapPropertySource;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.web.context.request.RequestAttributesThreadLocalAccessor;
+import org.springframework.web.context.request.RequestContextHolder;
+import org.springframework.web.context.request.ServletRequestAttributes;
+
+import java.util.Map;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ConcurrentRequestScopeLifecycleTest {
+
+    @AfterEach
+    void resetRequest() {
+        RequestContextHolder.resetRequestAttributes();
+    }
+
+    @Test
+    void closingContextStopsCleanerAndReleasesEntriesExactlyOnceDespiteCallbackFailure() throws Exception {
+        try (var context = context("true", "1h")) {
+            context.refresh();
+            ConcurrentRequestScope scope = scope(context);
+            ScheduledExecutorService cleaner = cleaner(scope);
+            AtomicInteger callbacks = new AtomicInteger();
+            ServletRequestAttributes first = bindRequest();
+            scope.get("failing", Object::new);
+            scope.registerDestructionCallback("failing", () -> {
+                callbacks.incrementAndGet();
+                throw new IllegalStateException("expected destruction failure");
+            });
+            ServletRequestAttributes second = bindRequest();
+            scope.get("remaining", Object::new);
+            scope.registerDestructionCallback("remaining", callbacks::incrementAndGet);
+
+            context.close();
+
+            assertTrue(cleaner.awaitTermination(2, TimeUnit.SECONDS), "context must terminate its cleaner");
+            assertEquals(2, callbacks.get());
+            assertEquals(0, scope.stateForTesting().activeEntryCount());
+            assertTrue(scope.stateForTesting().capacityInvariantHolds());
+            assertEquals(1, scope.stateForTesting().cleanupFailureCount());
+            first.requestCompleted();
+            second.requestCompleted();
+            context.close();
+            assertEquals(2, callbacks.get(), "late completion and repeated close must be harmless");
+            assertThrows(IllegalStateException.class, () -> scope.get("late", Object::new));
+            assertEquals(0, scope.stateForTesting().activeEntryCount());
+        }
+    }
+
+    @Test
+    void closingOneContextPreservesOtherContextTtlRequestsAndSharedAccessor() throws Exception {
+        try (var first = context("true", "1h"); var second = context("true", "1s")) {
+            first.refresh();
+            second.refresh();
+            ConcurrentRequestScope firstScope = scope(first);
+            ConcurrentRequestScope secondScope = scope(second);
+            Object accessor = ContextRegistry.getInstance().getThreadLocalAccessors().stream()
+                    .filter(value -> value instanceof RequestAttributesThreadLocalAccessor)
+                    .findFirst().orElseThrow();
+            ServletRequestAttributes sharedRequest = bindRequest();
+            AtomicInteger firstCallbacks = new AtomicInteger();
+            AtomicInteger secondCallbacks = new AtomicInteger();
+            firstScope.get("bean", Object::new);
+            firstScope.registerDestructionCallback("bean", firstCallbacks::incrementAndGet);
+            Object survivingBean = secondScope.get("bean", Object::new);
+            secondScope.registerDestructionCallback("bean", secondCallbacks::incrementAndGet);
+
+            first.close();
+
+            assertEquals(1, firstCallbacks.get());
+            assertEquals(0, secondCallbacks.get());
+            assertSame(survivingBean, secondScope.get("bean", Object::new));
+            assertTrue(ContextRegistry.getInstance().getThreadLocalAccessors().contains(accessor));
+            ContextSnapshot snapshot = ContextSnapshotFactory.builder().build().captureAll();
+            RequestContextHolder.resetRequestAttributes();
+            try (var ignored = snapshot.setThreadLocals()) {
+                assertSame(sharedRequest.getRequest(),
+                        ((ServletRequestAttributes) RequestContextHolder.currentRequestAttributes()).getRequest());
+                assertSame(survivingBean, secondScope.get("bean", Object::new));
+            }
+            sharedRequest.requestCompleted();
+            assertEquals(1, secondCallbacks.get());
+
+            CountDownLatch expired = new CountDownLatch(1);
+            ServletRequestAttributes abandoned = bindRequest();
+            secondScope.get("abandoned", Object::new);
+            secondScope.registerDestructionCallback("abandoned", expired::countDown);
+            RequestContextHolder.resetRequestAttributes();
+            assertTrue(expired.await(5, TimeUnit.SECONDS), "surviving context must keep running TTL cleanup");
+            second.close();
+            assertEquals(0, secondScope.stateForTesting().activeEntryCount());
+            assertTrue(secondScope.stateForTesting().capacityInvariantHolds());
+            abandoned.requestCompleted();
+        }
+    }
+
+    @Test
+    void closingContextWithTtlDisabledStillReleasesRequestResources() {
+        try (var context = context("false", "1h")) {
+            context.refresh();
+            ConcurrentRequestScope scope = scope(context);
+            AtomicInteger callbacks = new AtomicInteger();
+            ServletRequestAttributes attrs = bindRequest();
+            scope.get("bean", Object::new);
+            scope.registerDestructionCallback("bean", callbacks::incrementAndGet);
+            assertNull(cleaner(scope));
+
+            context.close();
+
+            assertEquals(1, callbacks.get());
+            assertEquals(0, scope.stateForTesting().activeEntryCount());
+            assertTrue(scope.stateForTesting().capacityInvariantHolds());
+            attrs.requestCompleted();
+            assertEquals(1, callbacks.get());
+        }
+    }
+
+    @Test
+    void failedContextRefreshAlsoStopsItsCleaner() throws Exception {
+        try (var context = context("true", "1h")) {
+            context.register(FailingConfig.class);
+            AtomicReference<ConcurrentRequestScope> captured = new AtomicReference<>();
+            context.getBeanFactory().registerSingleton("capturedScope", captured);
+
+            assertThrows(RuntimeException.class, context::refresh);
+
+            assertNotNull(captured.get());
+            assertTrue(cleaner(captured.get()).awaitTermination(2, TimeUnit.SECONDS));
+        }
+    }
+
+    @Test
+    void closeWaitsForInFlightBeanCreationAndDestroysItsCallback() throws Exception {
+        CountDownLatch factoryEntered = new CountDownLatch(1);
+        CountDownLatch releaseFactory = new CountDownLatch(1);
+        try (var context = context("true", "1h"); var workers = Executors.newVirtualThreadPerTaskExecutor()) {
+            context.refresh();
+            ConcurrentRequestScope scope = scope(context);
+            ServletRequestAttributes attrs = bindRequest();
+            AtomicInteger callbacks = new AtomicInteger();
+            var creation = workers.submit(() -> {
+                RequestContextHolder.setRequestAttributes(attrs);
+                try {
+                    return scope.get("bean", () -> {
+                        factoryEntered.countDown();
+                        try {
+                            if (!releaseFactory.await(5, TimeUnit.SECONDS)) {
+                                throw new IllegalStateException("factory was not released");
+                            }
+                        } catch (InterruptedException e) {
+                            Thread.currentThread().interrupt();
+                            throw new IllegalStateException(e);
+                        }
+                        scope.registerDestructionCallback("bean", callbacks::incrementAndGet);
+                        return new Object();
+                    });
+                } finally {
+                    RequestContextHolder.resetRequestAttributes();
+                }
+            });
+            try {
+                assertTrue(factoryEntered.await(3, TimeUnit.SECONDS));
+                CountDownLatch closeStarted = new CountDownLatch(1);
+                var closing = workers.submit(() -> {
+                    closeStarted.countDown();
+                    context.close();
+                });
+                assertTrue(closeStarted.await(3, TimeUnit.SECONDS));
+                assertFalse(closing.isDone());
+                releaseFactory.countDown();
+                assertNotNull(creation.get(3, TimeUnit.SECONDS));
+                closing.get(3, TimeUnit.SECONDS);
+                assertEquals(1, callbacks.get());
+                assertEquals(0, scope.stateForTesting().activeEntryCount());
+                assertTrue(scope.stateForTesting().capacityInvariantHolds());
+                attrs.requestCompleted();
+                assertEquals(1, callbacks.get());
+            } finally {
+                releaseFactory.countDown();
+            }
+        }
+    }
+
+    @Test
+    void closeInterruptsActiveCleanerAndWaitsForItsCallbackToFinish() throws Exception {
+        CountDownLatch callbackEntered = new CountDownLatch(1);
+        CountDownLatch callbackFinished = new CountDownLatch(1);
+        CountDownLatch releaseCallback = new CountDownLatch(1);
+        AtomicBoolean interrupted = new AtomicBoolean();
+        try (var context = context("true", "50ms")) {
+            context.refresh();
+            ConcurrentRequestScope scope = scope(context);
+            ServletRequestAttributes attrs = bindRequest();
+            scope.get("bean", Object::new);
+            scope.registerDestructionCallback("bean", () -> {
+                callbackEntered.countDown();
+                try {
+                    releaseCallback.await(5, TimeUnit.SECONDS);
+                } catch (InterruptedException e) {
+                    interrupted.set(true);
+                    Thread.currentThread().interrupt();
+                } finally {
+                    callbackFinished.countDown();
+                }
+            });
+            try {
+                assertTrue(callbackEntered.await(3, TimeUnit.SECONDS));
+
+                context.close();
+
+                assertTrue(interrupted.get());
+                assertEquals(0, callbackFinished.getCount());
+                assertTrue(cleaner(scope).awaitTermination(2, TimeUnit.SECONDS));
+                assertEquals(0, scope.stateForTesting().activeEntryCount());
+                assertTrue(scope.stateForTesting().capacityInvariantHolds());
+                attrs.requestCompleted();
+            } finally {
+                releaseCallback.countDown();
+            }
+        }
+    }
+
+    private static AnnotationConfigApplicationContext context(String enabled, String ttl) {
+        var context = new AnnotationConfigApplicationContext();
+        context.getEnvironment().getPropertySources().addFirst(new MapPropertySource("lifecycle-test", Map.of(
+                "concurrent-request-scope.stale-entry-cleanup.enabled", enabled,
+                "concurrent-request-scope.stale-entry-cleanup.ttl", ttl,
+                "concurrent-request-scope.stale-entry-cleanup.scan-interval", "10ms")));
+        context.register(EnabledConfig.class);
+        return context;
+    }
+
+    private static ConcurrentRequestScope scope(AnnotationConfigApplicationContext context) {
+        return (ConcurrentRequestScope) context.getBeanFactory()
+                .getRegisteredScope(ConcurrentRequestScopeNames.CONCURRENT_REQUEST_SCOPE);
+    }
+
+    private static ScheduledExecutorService cleaner(ConcurrentRequestScope scope) {
+        return (ScheduledExecutorService) ReflectionTestUtils.getField(scope, "staleEntryCleanupExecutor");
+    }
+
+    private static ServletRequestAttributes bindRequest() {
+        var attrs = new ServletRequestAttributes(new MockHttpServletRequest());
+        RequestContextHolder.setRequestAttributes(attrs);
+        return attrs;
+    }
+
+    @Configuration(proxyBeanMethods = false)
+    @EnableConcurrentRequestScope
+    static class EnabledConfig {
+    }
+
+    @Configuration(proxyBeanMethods = false)
+    static class FailingConfig {
+        @Bean
+        Object failingBean(AtomicReference<ConcurrentRequestScope> capturedScope,
+                           org.springframework.beans.factory.config.ConfigurableListableBeanFactory beanFactory) {
+            capturedScope.set((ConcurrentRequestScope) beanFactory.getRegisteredScope(
+                    ConcurrentRequestScopeNames.CONCURRENT_REQUEST_SCOPE));
+            throw new IllegalStateException("expected refresh failure");
+        }
+    }
+}
